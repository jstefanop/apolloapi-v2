#!/bin/bash

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

#This script assumes image_install has already been run previously

# Not `set -e`: the systemctl stop below and the cleanup steps exit non-zero
# benignly.
fail() {
    echo -e "${RED} ---> $1${NC}" >&2
    exit 1
}

copy_or_fail() {
    cp "$1" "$2" || fail "could not copy $1"
}

if [ "$EUID" -ne 0 ]
  then echo -e "${RED}Update script must be run by root or with sudo${NC}"
  exit 1
fi


systemctl stop ckpool apollo-miner node apollo-api apollo-ui-v2

#### SYSTEM PACKAGES ####
#########################
echo -e "${YELLOW} ---> Installing and upgrading required system packages${NC}"

# Install required system packages
apt-get update
# The Armbian packages own /etc/armbian-release, so this upgrade rewrites it and
# resets BOARD_NAME — which un-identifies an Apollo III: the UI renders Apollo
# I/II controls and miner_start.sh launches the USB miner that is not there.
BOARD_NAME_BEFORE=""
if [ -r /etc/armbian-release ]; then
    BOARD_NAME_BEFORE=$(grep -E "^BOARD_NAME=" /etc/armbian-release || true)
fi

apt-get -y upgrade

if [ -n "$BOARD_NAME_BEFORE" ] && [ -r /etc/armbian-release ]; then
    if ! grep -qxF "$BOARD_NAME_BEFORE" /etc/armbian-release; then
        echo -e "${YELLOW} ---> Restoring ${BOARD_NAME_BEFORE} (reset by the upgrade)${NC}"
        if grep -qE "^BOARD_NAME=" /etc/armbian-release; then
            sed -i "s|^BOARD_NAME=.*|${BOARD_NAME_BEFORE}|" /etc/armbian-release
        else
            echo "$BOARD_NAME_BEFORE" >> /etc/armbian-release
        fi
    fi
fi


APOLLO_DIR=/opt/apolloapi

git config --global --add safe.directory $APOLLO_DIR
git config --global --add safe.directory $APOLLO_DIR/apolloui-v2

chown -R futurebit $APOLLO_DIR

. /usr/local/nvm/nvm.sh

nvm use 21

### API ###
echo -e "${YELLOW} ---> Updating API modules${NC}"

cd $APOLLO_DIR || fail "cannot enter $APOLLO_DIR"

git reset --hard || fail "could not reset the API repo"
git pull || fail "could not pull the API repo"

# After the pull, so a failed run leaves the device re-runnable.
rm -f futurebit.sqlite

yarn || fail "yarn install failed for the API"

### UI ###
echo -e "${YELLOW} ---> Updating UI modules${NC}"

cd $APOLLO_DIR/apolloui-v2 || fail "cannot enter $APOLLO_DIR/apolloui-v2"

git reset --hard || fail "could not reset the UI repo"
git pull || fail "could not pull the UI repo"

API_BRANCH=$(git -C $APOLLO_DIR rev-parse --abbrev-ref HEAD) || fail "could not read the API branch"
UI_BRANCH=$(git -C $APOLLO_DIR/apolloui-v2 rev-parse --abbrev-ref HEAD) || fail "could not read the UI branch"

# image_install falls back to the UI's dev branch when a backend branch has no UI
# counterpart, so a mismatch is only fatal on main/staging.
is_release_branch() {
    [ "$1" = "main" ] || [ "$1" = "staging" ]
}

if [ "$API_BRANCH" != "$UI_BRANCH" ]; then
    if is_release_branch "$API_BRANCH" || is_release_branch "$UI_BRANCH"; then
        fail "API is on $API_BRANCH but the UI is on $UI_BRANCH, refusing to capture a mixed release image"
    fi
    echo -e "${YELLOW} ---> API is on $API_BRANCH, UI is on $UI_BRANCH (developer image)${NC}" >&2
fi

yarn || fail "yarn install failed for the UI"

echo -e "${YELLOW} ---> Building UI (could take few minutes)${NC}"

yarn build || fail "the UI build failed"

yarn cache clean
rm -rf .next/cache

chown -R futurebit $APOLLO_DIR


echo -e "${YELLOW} ---> Updating System binaries${NC}"

arch=$(uname -m)

copy_or_fail $APOLLO_DIR/backend/apollo-miner/bin/$arch/apollo-miner $APOLLO_DIR/backend/apollo-miner/futurebit-miner
copy_or_fail $APOLLO_DIR/backend/apollo-miner/bin/$arch/apollo-miner-v2 $APOLLO_DIR/backend/apollo-miner/futurebit-miner-v2
copy_or_fail $APOLLO_DIR/backend/apollo-miner/bin/$arch/apollo-miner-v3 $APOLLO_DIR/backend/apollo-miner/futurebit-miner-v3
copy_or_fail $APOLLO_DIR/backend/apollo-miner/bin/$arch/apollo-helper $APOLLO_DIR/backend/apollo-miner/

### Bitcoind ###
#########################
echo -e "${YELLOW} ---> Installing Bitcoin node${NC}"

# Current Default Core
NODE_SOFTWARE="core-28.1"


# Copy the correct bitcoind binary based on node_software
copy_or_fail $APOLLO_DIR/backend/node/bin/$NODE_SOFTWARE/$arch/bitcoind $APOLLO_DIR/backend/node/bitcoind
echo -e "${GREEN} ---> Copied $NODE_SOFTWARE bitcoind binary${NC}"

copy_or_fail $APOLLO_DIR/backend/default-configs/bitcoin.conf $APOLLO_DIR/backend/node/

#Create new api/user config files
touch $APOLLO_DIR/backend/node/api.conf
touch $APOLLO_DIR/backend/node/user.conf


### ckpool ###
#########################
copy_or_fail $APOLLO_DIR/backend/ckpool/bin/$arch/ckpool $APOLLO_DIR/backend/ckpool/
copy_or_fail $APOLLO_DIR/backend/default-configs/ckpool.conf $APOLLO_DIR/backend/ckpool/

### SYSTEMD ###
echo -e "${YELLOW} ---> Updating systemd files${NC}"

copy_or_fail $APOLLO_DIR/backend/systemd/apollo-api.service /etc/systemd/system/
copy_or_fail $APOLLO_DIR/backend/systemd/apollo-ui-v2.service /etc/systemd/system/
copy_or_fail $APOLLO_DIR/backend/systemd/apollo-miner.service /etc/systemd/system/
copy_or_fail $APOLLO_DIR/backend/systemd/node.service /etc/systemd/system/
copy_or_fail $APOLLO_DIR/backend/systemd/ckpool.service /etc/systemd/system/

#SWAP
copy_or_fail $APOLLO_DIR/backend/systemd/swap.service /etc/systemd/system/

#RC LOCAL
copy_or_fail $APOLLO_DIR/backend/rc.local /etc/
chmod +x /etc/rc.local
copy_or_fail $APOLLO_DIR/backend/systemd/rc-local.service /etc/systemd/system/

# Persistent journald (see backend/systemd/journald-apollo.conf). Non-fatal, and
# no restart needed here: the config applies at the next boot.
APOLLO_DIR="${APOLLO_DIR}" bash "${APOLLO_DIR}/backend/utils/install-journald.sh" || \
    echo "[journald] WARNING: could not install the journald policy; continuing" >&2

echo -e "${YELLOW} ---> Reloading systemd${NC}"
systemctl daemon-reload

# Enable the services
systemctl enable apollo-api.service
systemctl enable apollo-ui-v2.service
systemctl enable swap.service
systemctl enable rc-local.service
systemctl enable apollo-miner.service
systemctl enable node.service

echo -e "${GREEN} --->  Image update complete${NC}"
echo -e "${GREEN}       branch:  ${API_BRANCH}${NC}"
echo -e "${GREEN}       API:     $(git -C $APOLLO_DIR rev-parse --short HEAD)${NC}"
echo -e "${GREEN}       UI:      $(git -C $APOLLO_DIR/apolloui-v2 rev-parse --short HEAD)${NC}"
