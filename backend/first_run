#!/bin/bash
DEVICE=/dev/nvme0n1p1

#expand SD card
/usr/lib/armbian/armbian-resize-filesystem start


if [ ! -b "$DEVICE"  ]; then
        #format nvme drive if it has not been formatted yet
	parted /dev/nvme0n1 mklabel gpt -s
	parted -a opt /dev/nvme0n1 mkpart primary ext4 0% 100% -s
	mkfs.ext4 /dev/nvme0n1p1

	#configure node
	mkdir -p /media/nvme
	mount /dev/nvme0n1p1 /media/nvme
	tune2fs -m .1 /dev/nvme0n1p1
	mkdir -p /media/nvme/Bitcoin
	
else
        mkdir -p /media/nvme
	mount /dev/nvme0n1p1 /media/nvme
fi

chown -R futurebit /media/nvme/Bitcoin/

BITCOIN_LINK=/home/futurebit/.bitcoin
if [ -e "$BITCOIN_LINK" ] && [ ! -L "$BITCOIN_LINK" ]; then
	echo "$BITCOIN_LINK exists and is not a symlink; leaving it unchanged" >&2
else
	ln -sfnT /media/nvme/Bitcoin "$BITCOIN_LINK"
	chown -h futurebit:futurebit "$BITCOIN_LINK"
fi



#configure swap
fallocate -l 3G /media/nvme/swapfile
chmod 600 /media/nvme/swapfile
mkswap /media/nvme/swapfile

# Hand the mount over to rc.local for every later boot. It has to be guarded:
# rc.local is `#!/bin/sh -e`, and a device with no drive is a supported state
# since the node reports it for itself — an unguarded mount left rc-local.service
# failed at every boot, and would silently skip anything added after this line.
sed -i '$ d' /etc/rc.local
sed -i "\$i [ -b \/dev\/nvme0n1p1 ] \&\& mount \/dev\/nvme0n1p1 \/media\/nvme || true" /etc/rc.local